# Шаблон .env для сервера. Ключи НЕ коммитятся.
# Проще всего: скопировать локальный .env (scp) — состав переменных тот же.

WORK_BOT_TOKEN=

# ── DashScope: эмбеддинги + реранкер + vision ──
API_KEY=
BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# Vision-модель (фото товара). Можно поменять площадку одной переменной:
# VISION_MODEL=deepseek-flash и VISION_BASE_URL=https://api.deepseek.com/v1
VISION_API_KEY=
VISION_MODEL=
VISION_BASE_URL=

# ── RAG: чат — DeepSeek, эмбеддинги/реранк — DashScope ──
RAG_CHAT_API_KEY=
RAG_CHAT_BASE_URL=https://api.deepseek.com/v1
RAG_CHAT_MODEL=deepseek-chat
RAG_TOP_K=5
RAG_RERANK_ON=1
RAG_RERANK_MODEL=qwen3-rerank
RAG_EMBED_MODEL=text-embedding-v3

# ── Голос ──
YANDEX_API_KEY=

# ── Оператор (сводка/CSV по распознанным документам) ──
ADMIN_USER_IDS=