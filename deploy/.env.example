# Шаблон .env для сервера. Ключи НЕ коммитятся.
# Проще всего: скопировать локальный .env (scp) — состав переменных тот же.

WORK_BOT_TOKEN=

# Vision-модель (фото товара): DeepSeek с vision (deepseek-flash)
VISION_API_KEY=
VISION_MODEL=deepseek-flash
VISION_BASE_URL=https://api.deepseek.com/v1

# ── RAG: чат — DeepSeek, эмбеддинги — локальные (e5-small, в контейнере) ──
RAG_CHAT_API_KEY=
RAG_CHAT_BASE_URL=https://api.deepseek.com/v1
RAG_CHAT_MODEL=deepseek-chat
RAG_EMBED_PROVIDER=local
RAG_TOP_K=5
# Реранкер выключен (не нужен с локальным e5-small); включить — RAG_RERANK_ON=1 + DashScope-ключи
RAG_RERANK_ON=0

# Лимит платных LLM-вопросов на пользователя в час (0 = без лимита)
RAG_RATE_LIMIT_PER_HOUR=10

# ── Голос: Yandex SpeechKit (платный, см. цены; не free tier) ──
YANDEX_API_KEY=

# ── Оператор (сводка/CSV по распознанным документам) ──
ADMIN_USER_IDS=